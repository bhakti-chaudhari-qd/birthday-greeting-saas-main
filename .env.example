# PostgreSQL connection string
# On Neon/Vercel serverless, prefer the pooled URL (host contains -pooler).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/birthday_greeting_saas?schema=public"

# Node environment
NODE_ENV="development"

# Secret for authenticated internal scheduler HTTP endpoints only
# (Birthday / anniversary / custom automation cron + contact import drain + message worker drain)
# Required for GET|POST:
#               /api/v1/internal/cron/tick
#               /api/v1/internal/cron/birthday-automation
#               /api/v1/internal/cron/anniversary-automation
#               /api/v1/internal/cron/custom-automation
#               /api/v1/internal/cron/contact-import
#               /api/v1/internal/worker/drain
# Required in production (app fails closed at boot if missing).
# On Vercel: set the same name in Project → Environment Variables. Vercel Cron
# sends Authorization: Bearer <CRON_SECRET> automatically (see vercel.json).
# Preferred free external scheduler: cron-job.org → POST /api/v1/internal/cron/tick
#   (npm run cron:setup-external with CRONJOB_ORG_API_KEY + CRON_SECRET).
# Not required for local CLI:
#   npm run worker:drain
#   npm run automation:tick
#   npm run automation:scheduler
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Optional. Minutes between local automation:scheduler ticks (default 60 when
# run alone; npm run dev defaults to 1 for demos unless this is set).
# AUTOMATION_SCHEDULER_INTERVAL_MINUTES=5

# Optional. Raise for politician-scale tenants (platform send velocity ceilings).
# Effective per-org limit is min(these ceilings, subscription.monthlyMessageLimit).
# SEND_VELOCITY_PER_MINUTE=60
# SEND_VELOCITY_PER_DAY=5000

# Optional. Max concurrent provider sends in one worker drain (default 25).
# WORKER_GLOBAL_SEND_CONCURRENCY=25

# Optional. Minimum automation queue creates per org per cron run (default 500).
# Tests set this to 50 via vitest.config.ts.
# AUTOMATION_CREATES_FLOOR=500

# Optional. Set to 0/false to start Next without the automation scheduler
# when using npm run dev. Or use: npm run dev:app
# DEV_AUTOMATION=1

# Base64-encoded 32-byte key used to encrypt ChannelConfig credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production (app fails closed at boot if missing/invalid).
CREDENTIALS_ENCRYPTION_KEY=""

# App public URL (used in verification / password-reset email links)
APP_URL="http://localhost:3000"

# Dedicated Platform Admin vendor-invitation SMS gateway. This is separate from
# every organization's ChannelConfig and is required when issuing invitations.
# The approved body must contain exactly {{registrationUrl}} and {{vendorName}}
# placeholders, in the same positions approved in the DLT portal.
PLATFORM_APP_URL="http://localhost:3000"
PLATFORM_SMS_BASE_URL="https://your-provider.example"
PLATFORM_SMS_SEND_PATH="/send.aspx"
PLATFORM_SMS_USERNAME=""
PLATFORM_SMS_PASSWORD=""
PLATFORM_SMS_ROUTE="trans1"
PLATFORM_SMS_SENDER_ID=""
PLATFORM_SMS_DLT_TEMPLATE_ID=""
PLATFORM_SMS_INVITATION_BODY_TEMPLATE="Complete your vendor registration at {{registrationUrl}} for {{vendorName}}."

# Platform default SMS gateway for greetings. Clients that haven't set up their
# own SMS gateway send through this one - but only once they have an active paid
# plan or platform approval (the same gate as configuring their own live SMS).
# All six values are required; leave them all unset to turn the default off.
# Templates must be DLT-approved for this gateway's sender/entity.
# DEFAULT_SMS_BASE_URL="https://your-provider.example"
# DEFAULT_SMS_SEND_PATH="/send.aspx"
# DEFAULT_SMS_USERNAME=""
# DEFAULT_SMS_PASSWORD=""
# DEFAULT_SMS_ROUTE="trans1"
# DEFAULT_SMS_SENDER_ID=""

# Resend (password reset, email verification, and greeting emails). Without
# RESEND_API_KEY in development, auth emails are logged to the server console.
# Greeting emails require RESEND_API_KEY (or an EMAIL TEST ChannelConfig).
# RESEND_API_KEY=""
# EMAIL_FROM is the default sender for clients with no Email config of their own,
# and for system emails. It must be an address on a domain verified in Resend;
# onboarding@resend.dev is Resend's shared test sender and only delivers to your
# own Resend account's email.
# EMAIL_FROM="Birthday Greeting <greetings@yourdomain.com>"

# --- Billing (Razorpay) — Settings → Billing; set keys in .env.local (never commit secrets) ---
# In production, if BILLING_ENABLED=true OR any Razorpay key is set, all three
# Razorpay secrets below are required or the app fails closed at boot.
# BILLING_ENABLED="true"
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# Optional: reuse Razorpay Plan ids for STARTER/PRO subscriptions (otherwise created at runtime)
# RAZORPAY_PLAN_STARTER="plan_..."
# RAZORPAY_PLAN_PRO="plan_..."
# Webhook URLs (same handler):
#   {APP_URL}/api/webhooks/razorpay
#   {APP_URL}/api/v1/billing/webhooks/razorpay
# Events: payment.captured, order.paid, payment_link.paid, payment.failed,
#   subscription.charged, invoice.paid, subscription.cancelled, subscription.halted
# Catalogue (server): STARTER ₹499 / 1k contacts / 10k msgs; PRO ₹1499 / 10k / 100k
# Credit packs: credits-5k ₹299 / +5k msgs; credits-25k ₹999 / +25k msgs

# WhatsApp Custom HTTP has no product-default gateway URL.
# Configure baseUrl + sendPath + username per tenant in /dashboard/settings/whatsapp
# when using provider CUSTOM_HTTP for temporary testing.

# SMS Custom HTTP also has no product-default gateway URL.
# Configure baseUrl + sendPath + credentials per tenant in /dashboard/settings/sms
# when using provider CUSTOM_HTTP for temporary testing.

# Local development SMS channel configuration (scripts/configure-sms-channel.ts)
# SMS_USERNAME=""
# SMS_PASSWORD=""
# SMS_BASE_URL="https://your-provider.example"
# SMS_SEND_PATH="/send.aspx"
# SMS_ROUTE="trans1"
# SMS_SENDER_ID="QDTECH"
# SMS_CONFIG_ORGANIZATION_SLUG="acme-corp-demo"

# Demo Live OTP template (seeded for easy live SMS demos).
# Defaults match the Quickly Design OTP DLT template already verified via Manual Send.
# DEMO_SMS_DLT_TEMPLATE_ID="1707174533394491241"
# DEMO_SMS_DLT_APPROVED_CONTENT="Dear User your {#var#} OTP for your Quickly Design application. https://www.quicklytech.in/ Valid for 10 mins QUICKLY DESIGN TECHNOLOGY PRIVATE LIMITED"
# DEMO_SMS_BODY="Dear User your {{name}} OTP for your Quickly Design application. https://www.quicklytech.in/ Valid for 10 mins QUICKLY DESIGN TECHNOLOGY PRIVATE LIMITED"

# Vendor referral codes are configured per Vendor (Platform Admin → Vendors).
# Register accepts an optional referral code for attribution.

# Per-org outbound send velocity (worker); defaults 60/min and 5000/day
# SEND_VELOCITY_PER_MINUTE="60"
# SEND_VELOCITY_PER_DAY="5000"

# OpenAI — AI Draft Studio text drafts (Phase 1–2). Optional; curated drafts if unset.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# Phase 3 video greetings are generated in the browser and attached as WhatsApp
# Custom HTTP media (JPEG/MP4/WebM). No separate video API key required.

# Optional. Comma-separated hosts allowed to load Next.js client assets in development
# when you open the app via a LAN/non-localhost address (not needed for localhost).
# Restart `npm run dev` after changing this value.
# Example:
# ALLOWED_DEV_ORIGINS="192.168.1.100"

# Backblaze B2 (generated-document storage, Phase 5). Optional - without these,
# generating a document fails clearly ("Document storage is not configured")
# instead of crashing the app or any unrelated functionality at boot.
# B2 is S3-compatible; the app talks to it via the standard AWS S3 SDK, so
# swapping to AWS S3, Cloudflare R2, or another S3-compatible provider later
# only means adding a new adapter next to src/lib/storage/b2-storage.ts and
# changing one line in src/lib/storage/index.ts - not the rest of the app
# (see src/lib/storage for the provider-agnostic storage interface).
# Create a bucket + application key (Read & Write) in the Backblaze dashboard;
# B2_ENDPOINT/B2_REGION come from the bucket's S3-compatible endpoint details.
# B2_ENDPOINT="https://s3.<region>.backblazeb2.com"
# B2_REGION=""
# B2_APPLICATION_KEY_ID=""
# B2_APPLICATION_KEY=""
# B2_BUCKET_NAME=""
